# OCI Containerfile for building 3ds_pieceduel (.elf, .smdh, .3dsx, .cia)
# Compatible with podman build or docker build.
FROM docker.io/devkitpro/devkitarm:latest

ENV DEVKITPRO=/opt/devkitpro
ENV DEVKITARM=/opt/devkitpro/devkitARM
ENV PATH="${DEVKITPRO}/tools/bin:${DEVKITARM}/bin:${PATH}"

# Install bannertool and makerom for .cia packaging alongside 3ds-dev (libctru, citro2d, citro3d)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    ca-certificates \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/* \
    && dkp-pacman -Syu --noconfirm 3ds-dev 3ds-tools 2>/dev/null || true \
    && if ! command -v makerom >/dev/null 2>&1; then \
         curl -fsSL https://github.com/3DSGuy/Project_CTR/releases/download/makerom-v0.18.4/makerom-v0.18.4-ubuntu_x86_64.zip -o /tmp/makerom.zip && \
         unzip -q /tmp/makerom.zip -d /usr/local/bin && chmod +x /usr/local/bin/makerom && rm -f /tmp/makerom.zip; \
       fi \
    && if ! command -v bannertool >/dev/null 2>&1; then \
         curl -fsSL https://github.com/Steveice10/bannertool/releases/download/1.2.0/bannertool.zip -o /tmp/bannertool.zip && \
         unzip -q -j /tmp/bannertool.zip "*linux-x86_64/bannertool" -d /usr/local/bin && chmod +x /usr/local/bin/bannertool && rm -f /tmp/bannertool.zip || true; \
       fi

WORKDIR /work
